{
  "name": "gitcrook",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @gitcrook/web dev",
    "build": "pnpm --filter @gitcrook/web build",
    "worker": "pnpm --filter @gitcrook/worker dev",
    "db:generate": "pnpm --filter @gitcrook/db exec prisma generate",
    "db:migrate": "pnpm --filter @gitcrook/db exec prisma migrate dev",
    "db:deploy": "pnpm --filter @gitcrook/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @gitcrook/db exec prisma db seed",
    "db:studio": "pnpm --filter @gitcrook/db exec prisma studio",
    "test": "vitest run",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
