{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Offxc/GitCrook/main/docs/git-sync/schemas/gitcrook.schema.json",
  "title": "gitcrook.yaml",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "root": {
      "type": "string"
    },
    "nav": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "redirects": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "definitions": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "icon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "pages": {
              "maxItems": 2000,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "icon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "pages": {
              "maxItems": 2000,
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema0"
              }
            }
          },
          "required": [
            "group",
            "pages"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
