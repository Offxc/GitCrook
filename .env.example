# Copy to .env and fill in. See the README's "Self-hosting" section for the production/Docker values.

# NODE_ENV is deliberately not set here. Next sets it per command (development
# for `next dev`, production for `next build`), and a value in this file is
# loaded by the dotenv wrapper in apps/web's scripts — a stale
# NODE_ENV=development made `pnpm build` fail while the Docker build, which
# doesn't read this file, succeeded. The env schema defaults it anyway.

# Local dev: run `pnpm --filter @gitcrook/db dev:pg` in another terminal first
# (spins up a real local Postgres via the `embedded-postgres` package, no
# Docker/root needed), then use this connection string.
# Production (Docker Compose): postgresql://gitcrook:<password>@postgres:5432/gitcrook
DATABASE_URL="postgresql://gitcrook:gitcrook_dev@127.0.0.1:55432/gitcrook"

# Not required — password-gate rate limiting is in-memory
# (packages/shared/src/rateLimit.ts); nothing in this stack needs Redis.
# REDIS_URL="redis://127.0.0.1:6379"

# Docker Compose only (ignored in local dev): the `postgres` service's own
# password. docker-compose.yml builds DATABASE_URL from this automatically —
# don't set DATABASE_URL directly when deploying via Compose.
# POSTGRES_PASSWORD="generate-a-real-one"

# Docker Compose only, and only needed for a deployment whose data volume was
# created under different names. Postgres applies these when it initialises an
# empty data directory and never again, so an existing volume keeps the role
# and database it was created with — point these at those instead of letting
# the defaults (gitcrook/gitcrook) be wrong.
# POSTGRES_USER="voiddocs"
# POSTGRES_DB="voiddocs"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Discord Developer Portal -> New Application -> OAuth2.
# Redirect URI: http://localhost:3000/api/auth/callback/discord (dev)
#           or  https://docs.voidsmp.com/api/auth/callback/discord (prod)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Who may create a NEW account. Sign-up is closed by default: only a Discord ID listed in
# ALLOWED_DISCORD_IDS, someone with a pending email invitation (from Members in the
# dashboard; their Discord email must be verified), and — on an empty database — the very
# first sign-in, who becomes the instance owner. People who already have an account can
# always sign in. Set SIGNUP_MODE=open only if you want any Discord account to get its own
# organization (and the ability to publish under your domain).
# SIGNUP_MODE="closed"

# Comma-separated Discord user IDs allowed to create an account. Setting it also turns off
# "the first sign-in becomes the owner", so put your own ID here before you expose a new
# deployment; otherwise sign in yourself immediately after it comes up.
# ALLOWED_DISCORD_IDS="123456789012345678"

ROOT_DOMAIN="localhost:3000"
ROOT_PROTOCOL="http"

# Local dev only — Docker Compose sets both of these itself (STORAGE_DIR to
# the shared `uploads` volume in docker-compose.yml; CHROMIUM_EXECUTABLE_PATH
# is baked into docker/worker.Dockerfile's image). Only uncomment locally, and
# only STORAGE_DIR if you're running apps/worker alongside apps/web. It must be
# absolute once more than one process uses it (each resolves a relative path
# against its own working directory).
# STORAGE_DIR="/absolute/path/to/apps/web/.data/uploads"
# CHROMIUM_EXECUTABLE_PATH="/path/to/a/local/chrome-or-chromium"

# ---- Git Sync (optional) ------------------------------------------------------------------------
# Keep a site's pages in a Git repository. Nothing here is needed to use GitCrook without it; see
# docs/git-sync/README.md for the setup. A public repository needs no credential at all.

# Encrypts the access tokens saved for private repositories (AES-256-GCM). Required to save a token.
# Generate with: openssl rand -base64 32
# To rotate: put the new key here and the old one(s), comma-separated, in GIT_SYNC_ENCRYPTION_KEYS_PREVIOUS;
# existing tokens keep working and are re-encrypted when they are next saved.
# GIT_SYNC_ENCRYPTION_KEY=""
# GIT_SYNC_ENCRYPTION_KEYS_PREVIOUS=""

# Verifies GitHub's push webhooks (Payload URL: https://<your-domain>/api/webhooks/github, content type
# application/json, event: push). Without it webhooks are refused and sources sync by polling instead.
# Generate with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=""

# GitHub Enterprise Server: the API base (https://ghe.example.com/api/v3). Default: https://api.github.com
# GITHUB_API_URL=""
# The only hosts the worker will contact. Default: the host of GITHUB_API_URL.
# GIT_SYNC_ALLOWED_HOSTS=""
# Repositories synced at once (default 2).
# GIT_SYNC_CONCURRENCY="2"
